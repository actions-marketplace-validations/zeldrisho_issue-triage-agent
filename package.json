{
  "name": "issue-ai-agent",
  "version": "0.2.0",
  "private": true,
  "description": "AI-powered GitHub Issue triage and auto-reply Action",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "prepare": "vp config --no-agent",
    "build": "tsc",
    "bundle": "tsc --noEmit && vp pack",
    "dev": "tsc --watch",
    "test": "vp test run",
    "test:watch": "vp test"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@anthropic-ai/sdk": "^1.8.0",
    "js-yaml": "^5.5.0",
    "openai": "^7.57.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "catalog:",
    "rolldown-license-plugin": "^3.0.15",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">= 22"
  },
  "packageManager": "pnpm@12.21.0"
}
